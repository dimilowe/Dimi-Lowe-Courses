{
  "name": "workspace",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npx tsx scripts/db/migrate.ts",
    "db:migrate:dev": "DB_TARGET=dev npm run db:migrate",
    "db:migrate:prod": "DB_TARGET=prod npm run db:migrate",
    "db:local:start": "docker compose up -d postgres",
    "db:local:stop": "docker compose stop postgres",
    "db:local:down": "docker compose down",
    "db:local:logs": "docker compose logs -f postgres",
    "db:verify": "npx tsx scripts/db/verify.ts",
    "db:verify:dev": "DB_TARGET=dev npm run db:verify",
    "db:verify:prod": "DB_TARGET=prod npm run db:verify"
  },
